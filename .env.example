# ============ SERVER ============
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ============ DATABASE ============
DB_TYPE=sqlite
SQLITE_PATH=./data/mini-rag.db

# Para PostgreSQL:
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=mini_rag_pro

# ============ GEMINI API (fallback si el usuario no provee su propia key) ============
GEMINI_API_KEY=your_gemini_api_key_here

# ============ JWT ============
JWT_SECRET=cambiar-este-secreto-por-uno-de-32-caracteres-minimo
